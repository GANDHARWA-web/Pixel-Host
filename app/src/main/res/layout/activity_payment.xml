<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <ScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_dark">

        <LinearLayout
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:text="Payment"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvSummary"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <EditText
                android:id="@+id/etEmail"
                android:hint="Email (for order details)"
                android:inputType="textEmailAddress"
                android:textColorHint="@color/text_secondary"
                android:textColor="@color/text_primary"
                android:background="@color/card_dark"
                android:padding="12dp"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>


            <!-- method (outline shows selection; mutual exclusive via RadioGroup) -->
            <RadioGroup
                android:id="@+id/rgMethod"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rbCard"
                    android:text="Card"
                    android:textColor="@color/text_primary"
                    android:checked="true"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/bg_selectable_choice"
                    android:button="@null"
                    android:layout_marginEnd="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <RadioButton
                    android:id="@+id/rbUpi"
                    android:text="UPI"
                    android:textColor="@color/text_primary"
                    android:paddingLeft="16dp"
                    android:paddingRight="16dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/bg_selectable_choice"
                    android:button="@null"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </RadioGroup>

            <!-- Card fields -->
            <LinearLayout
                android:id="@+id/cardFields"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/etCardNumber"
                    android:hint="Card Number"
                    android:inputType="number"
                    android:maxLength="16"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/text_primary"
                    android:background="@color/card_dark"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <!-- Expiry + CVV row -->
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/etMonth"
                        android:hint="MM"
                        android:inputType="number"
                        android:maxLength="2"
                        android:textColorHint="@color/text_secondary"
                        android:textColor="@color/text_primary"
                        android:background="@color/card_dark"
                        android:padding="12dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <EditText
                        android:id="@+id/etYear"
                        android:hint="YYYY"
                        android:inputType="number"
                        android:maxLength="4"
                        android:textColorHint="@color/text_secondary"
                        android:textColor="@color/text_primary"
                        android:background="@color/card_dark"
                        android:padding="12dp"
                        android:layout_marginStart="8dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>

                    <!-- ADDED: CVV (3 digits, numeric only) -->
                    <EditText
                        android:id="@+id/etCvv"
                        android:hint="CVV"
                        android:inputType="numberPassword"
                        android:maxLength="3"
                        android:textColorHint="@color/text_secondary"
                        android:textColor="@color/text_primary"
                        android:background="@color/card_dark"
                        android:padding="12dp"
                        android:layout_marginStart="8dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>

                <EditText
                    android:id="@+id/etCardName"
                    android:hint="Cardholder Name"
                    android:inputType="textCapWords"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/text_primary"
                    android:background="@color/card_dark"
                    android:padding="12dp"
                    android:layout_marginTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- UPI fields -->
            <LinearLayout
                android:id="@+id/upiFields"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/etUpiId"
                    android:hint="UPI ID (e.g., name@bank)"
                    android:inputType="textEmailAddress"
                    android:textColorHint="@color/text_secondary"
                    android:textColor="@color/text_primary"
                    android:background="@color/card_dark"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>

            <TextView
                android:id="@+id/btnPay"
                android:text="Pay"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:gravity="center"
                android:padding="14dp"
                android:layout_marginTop="18dp"
                android:background="@color/card_dark"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>
