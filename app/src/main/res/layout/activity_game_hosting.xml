<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_dark"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">


    <TextView
        android:id="@+id/title"
        android:text="Game Hosting — Step 1"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:id="@+id/sub"
        android:text="Choose your game server"
        android:textColor="@color/text_secondary"
        android:layout_below="@id/title"
        android:layout_marginTop="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <!-- Cards row -->
    <LinearLayout
        android:id="@+id/row"
        android:layout_below="@id/sub"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardMinecraft"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardUseCompatPadding="true"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="@android:color/transparent">

            <!-- container gets the selectable background -->
            <FrameLayout
                android:id="@+id/containerMinecraft"
                android:background="@drawable/bg_selectable_card"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- main content centered -->
                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:src="@drawable/ic_dns_24"
                        android:tint="@color/accent_teal"
                        android:layout_width="40dp"
                        android:layout_height="40dp"/>

                    <TextView
                        android:text="Minecraft"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- selected badge (hidden by default) -->
                <TextView
                    android:id="@+id/badgeMinecraft"
                    android:text="Selected"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_selected_badge"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
        </androidx.cardview.widget.CardView>


        <androidx.cardview.widget.CardView
            android:id="@+id/cardARK"
            android:layout_width="0dp"
            android:layout_height="120dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardUseCompatPadding="true"
            app:cardCornerRadius="18dp"
            app:cardBackgroundColor="@android:color/transparent">

            <!-- container gets the selectable background -->
            <FrameLayout
                android:id="@+id/containerARK"
                android:background="@drawable/bg_selectable_card"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- main content centered -->
                <LinearLayout
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:src="@drawable/ic_dns_24"
                        android:tint="@color/accent_teal"
                        android:layout_width="40dp"
                        android:layout_height="40dp"/>

                    <TextView
                        android:text="ARK"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginTop="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>

                <!-- selected badge (hidden by default) -->
                <TextView
                    android:id="@+id/badgeARK"
                    android:text="Selected"
                    android:textColor="@color/black"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:background="@drawable/bg_selected_badge"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
        </androidx.cardview.widget.CardView>


    </LinearLayout>

    <!-- Next button -->
    <TextView
        android:id="@+id/btnNext"
        android:text="Next >"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:padding="14dp"
        android:background="@color/card_dark"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Global Checkout FAB (visible on step screens) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCheckout"
        android:contentDescription="Checkout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        app:srcCompat="@android:drawable/ic_dialog_info"
        app:backgroundTint="@color/accent_teal" />

</RelativeLayout>
